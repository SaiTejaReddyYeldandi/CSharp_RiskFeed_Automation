{
  "name": "risk-feed-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --configLoader native --config vite.config.ts",
    "build": "tsc -b && vite build --configLoader native --config vite.config.ts",
    "preview": "vite preview --host 0.0.0.0 --configLoader native --config vite.config.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
